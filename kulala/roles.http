### list roles (admin)

GET {{BASE_URL}}/roles?page=1&per_page=10
Authorization: Bearer {{login.response.cookies.access_token.value}}

### get role (admin)

GET {{BASE_URL}}/roles/1
Authorization: Bearer {{login.response.cookies.access_token.value}}

### create role (superadmin)

POST {{BASE_URL}}/roles
Authorization: Bearer {{login.response.cookies.access_token.value}}

{
  "name": "VIEWER",
  "description": "Read only."
}

### update role (superadmin)

PUT {{BASE_URL}}/roles/1
Authorization: Bearer {{login.response.cookies.access_token.value}}

{
  "name": "VIEWER",
  "description": "Read only."
}

### delete role (superadmin)

DELETE {{BASE_URL}}/roles/1
Authorization: Bearer {{login.response.cookies.access_token.value}}
