# Copy to app.env and fill in real values. app.env is gitignored (*.env) and
# must NOT be committed. The app reads this file via viper (config name "app",
# type "env"), not .env (which belong to devenv/DB-UI).

ENVIRONMENT=development
GIN_MODE=release

# Database. PG_DB_PASSWORD_ENC is the URL-encoded form of PG_DB_PASSWORD
# (used inside DB_SOURCE, so special characters must be percent-encoded).
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=changeme
PG_HOST=localhost
PG_PORT=5432
PG_DB_NAME=weather
PG_DB_USER=weatheradmin
PG_DB_PASSWORD=changeme
PG_DB_PASSWORD_ENC=changeme

DB_DRIVER=postgres
DB_SOURCE="postgresql://${PG_DB_USER}:${PG_DB_PASSWORD_ENC}@${PG_HOST}:${PG_PORT}/${PG_DB_NAME}?sslmode=disable"

MIGRATION_PATH=internal/db/migration

DOCKERTEST_PG_REPO="docker.io/postgis/postgis"
DOCKERTEST_PG_TAG="12-3.5"

API_BASE_PATH=/api/v1
SWAG_API_BASE_PATH=/api/v1

# Auth cookies are host-only by default. Set COOKIE_DOMAIN to share across subdomains.
# COOKIE_DOMAIN=.observatory.ph
COOKIE_PATH=/

# Comma-separated allowed CORS origins (empty = same-origin only).
CORS_ALLOW_ORIGINS=

HTTP_SERVER_ADDRESS=0.0.0.0:3000

# TOKEN_SYMMETRIC_KEY must be exactly 32 characters (PASETO v4 symmetric key).
TOKEN_SYMMETRIC_KEY=0123456789abcdef0123456789abcdef
ACCESS_TOKEN_DURATION=5m
REFRESH_TOKEN_DURATION=24h

GLABS_APP_ID=changeme
GLABS_APP_SECRET=changeme

ENABLE_CONSOLE_LOGGING=1
ENABLE_FILE_LOGGING=1
LOG_LEVEL=debug
LOG_DIRECTORY=./dist/logs
LOG_FILENAME=dev.log
